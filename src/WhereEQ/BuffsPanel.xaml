<UserControl x:Class="WhereEQ.BuffsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DropShadowEffect x:Key="Shadow" ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/>

        <!-- A section heading ("On Name", "Your spells on others") or a spell with a draining bar behind it. -->
        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <TextBlock x:Name="Header" Text="{Binding Header}" Foreground="#BBFFFFFF" FontSize="10.5"
                           FontWeight="SemiBold" Margin="2,4,0,1" Visibility="Collapsed"/>
                <Grid x:Name="Spell" ToolTip="{Binding Tip}">
                    <Rectangle RadiusX="2" RadiusY="2" Fill="{Binding BarBrush}" Opacity="0.55"
                               HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Grid Margin="4,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LeftText" Text="{Binding LeftText}" Foreground="White" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="Header" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Spell" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Soon}" Value="True">
                    <Setter TargetName="LeftText" Property="Foreground" Value="#FFD54F"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ListBox x:Name="List" Background="Transparent" BorderThickness="0" FontSize="12"
                 Grid.IsSharedSizeScope="True" ItemContainerStyle="{StaticResource RowStyle}"
                 ItemTemplate="{StaticResource RowTemplate}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PreviewKeyDown="List_KeyDown">
            <ListBox.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/>
            </ListBox.Effect>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Remove" Click="Remove_Click" InputGestureText="Del"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
        <TextBlock x:Name="EmptyText" Margin="8,4" Foreground="#DDFFFFFF" FontSize="11" TextWrapping="Wrap"
                   IsHitTestVisible="False" Effect="{StaticResource Shadow}"/>
    </Grid>
</UserControl>
