<Window x:Class="WhereEQ.BuffsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhereEQ Buffs" Width="230" Height="260" MinWidth="150" MinHeight="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/>

        <Style x:Key="SideButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#665A8DEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A section heading ("On you", "Your spells") or a spell with a draining bar behind it. -->
        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <TextBlock x:Name="Header" Text="{Binding Header}" Foreground="#BBFFFFFF" FontSize="10.5"
                           FontWeight="SemiBold" Margin="2,4,0,1" Visibility="Collapsed"/>
                <Grid x:Name="Spell" ToolTip="{Binding Tip}">
                    <Rectangle x:Name="Bar" RadiusX="2" RadiusY="2" Fill="{Binding BarBrush}" Opacity="0.55"
                               HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Fraction}"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Grid Margin="4,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LeftText" Text="{Binding LeftText}" Foreground="White" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="Header" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Spell" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Soon}" Value="True">
                    <Setter TargetName="LeftText" Property="Foreground" Value="#FFD54F"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Backdrop" Background="Black" Opacity="0.35" CornerRadius="6"/>
        <Border x:Name="Frame" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="6"/>

        <DockPanel>
            <Border x:Name="TitleBar" DockPanel.Dock="Right" Background="#CC1E1E1E" CornerRadius="0,6,6,0"
                    Cursor="SizeAll" ToolTip="Drag here or anywhere on the list to move">
                <StackPanel Margin="2,4,2,16">
                    <TextBlock Text="⠿" Foreground="#AAFFFFFF" HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,2"/>
                    <ToggleButton x:Name="OptionsButton" Content="⚙" ToolTip="Options"
                                  Style="{StaticResource SideButton}" Click="OptionsButton_Click"/>
                    <Button Content="🔒" ToolTip="Lock: clicks go through to the game (Ctrl+Alt+B toggles)"
                            Style="{StaticResource SideButton}" Click="Lock_Click"/>
                    <Button Content="✕" ToolTip="Close buffs" Style="{StaticResource SideButton}" Click="Close_Click"/>
                </StackPanel>
            </Border>

            <Grid Margin="2,2,2,4">
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" FontSize="12"
                         Grid.IsSharedSizeScope="True" ItemContainerStyle="{StaticResource RowStyle}"
                         ItemTemplate="{StaticResource RowTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="List_KeyDown">
                    <ListBox.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/>
                    </ListBox.Effect>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remove" Click="Remove_Click" InputGestureText="Del"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock x:Name="EmptyText" Margin="8,4" Foreground="#DDFFFFFF" FontSize="11" TextWrapping="Wrap"
                           IsHitTestVisible="False" Effect="{StaticResource Shadow}"/>
            </Grid>
        </DockPanel>

        <!-- Options panel (⚙). -->
        <Border x:Name="OptionsPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="4,4,34,4"
                Background="#EE202020" CornerRadius="6" Padding="10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Character" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CharacterBox" SelectionChanged="Character_Changed"
                              ToolTip="Whose buffs to show. Active = whoever's log changed most recently."/>
                </DockPanel>
                <CheckBox x:Name="OthersCheck" Content="Spells you cast on others" Foreground="White" Margin="0,0,0,6"
                          Click="Others_Click"
                          ToolTip="Mez, DoTs, slows and buffs you cast on mobs and groupmates, until they wear off."/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Backdrop" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="BackdropSlider" Minimum="0" Maximum="0.9" ValueChanged="Backdrop_Changed"/>
                </DockPanel>
                <TextBlock x:Name="HintText" Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
