<Window x:Class="WhereEQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhereEQ" Width="1100" Height="720" MinWidth="640" MinHeight="400">
    <DockPanel Margin="12">

        <!-- Top bar: data folder, always-on-top, status -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Watching:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="FolderText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource MutedBrush}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
                <Button Content="🗺 Map" Click="Map_Click" Margin="0,0,8,0"
                        ToolTip="Open the transparent map overlay (Ctrl+Alt+M toggles click-through)"/>
                <Button Content="Settings…" Click="Settings_Click"/>
            </StackPanel>
            <CheckBox x:Name="TopmostCheck" Grid.Column="3" Content="Always on top" VerticalAlignment="Center"
                      Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
        </Grid>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/>

        <TabControl x:Name="Tabs">

            <!-- ============ FIND ITEM ============ -->
            <TabItem Header="Find item">
                <DockPanel Margin="0,8,0,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" FontSize="16" TextChanged="Search_Changed"
                                 ToolTip="Part of an item name, or an item ID. Separate several names with commas."/>
                        <ComboBox x:Name="CharacterFilter" Grid.Column="1" Width="180" Margin="8,0,0,0"
                                  SelectionChanged="Search_Changed"/>
                        <Button x:Name="ResetSearchButton" Grid.Column="2" Content="Reset" Margin="8,0,0,0" Padding="12,0" VerticalAlignment="Stretch"
                                Click="ResetSearch_Click"
                                ToolTip="Clear the search and go back to all characters, Equipped + Inventory + Bank, no bags."/>
                    </Grid>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <CheckBox x:Name="AreaEquipped" Content="Equipped" IsChecked="True" Margin="0,0,16,0" Click="Search_Changed"/>
                        <CheckBox x:Name="AreaInventory" Content="Inventory" IsChecked="True" Margin="0,0,16,0" Click="Search_Changed"/>
                        <CheckBox x:Name="AreaBank" Content="Bank" IsChecked="True" Margin="0,0,16,0" Click="Search_Changed"/>
                        <CheckBox x:Name="ShowBags" Content="Include bags" IsChecked="False" Margin="0,0,16,0" Click="Search_Changed"/>
                    </WrapPanel>
                    <TextBlock x:Name="SearchSummary" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended"
                              MouseDoubleClick="Results_DoubleClick" PreviewMouseRightButtonUp="ItemGrid_RightClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="130"/>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Count}" Width="60"/>
                            <DataGridTextColumn Header="Area" Binding="{Binding AreaText}" Width="100"/>
                            <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="2*"/>
                            <DataGridTextColumn Header="Snapshot" Binding="{Binding SnapshotTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ BAGS ============ -->
            <TabItem Header="Bags">
                <DockPanel Margin="0,8,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ComboBox x:Name="BagsCharacterFilter" Width="180" Margin="0,0,16,0" SelectionChanged="BagsFilter_Changed"/>
                        <CheckBox x:Name="BagsInventory" Content="Inventory" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" Click="BagsFilter_Changed"/>
                        <CheckBox x:Name="BagsBank" Content="Bank" IsChecked="True" VerticalAlignment="Center" Click="BagsFilter_Changed"/>
                    </WrapPanel>
                    <TextBlock x:Name="BagsSummary" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"/>
                    <DataGrid x:Name="BagsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None" MouseDoubleClick="Bags_DoubleClick" PreviewMouseRightButtonUp="ItemGrid_RightClick">
                        <DataGrid.Resources>
                            <!-- Bank slot status: red = no bag, yellow = bag under 10 slots, green = 10-slot bag.
                                 Only cell content is styled; restyling DataGridRow breaks the Fluent theme. -->
                            <Style x:Key="BagStatusText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="None">
                                        <Setter Property="Foreground" Value="{StaticResource MissingBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Small">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Full">
                                        <Setter Property="Foreground" Value="{StaticResource HaveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="110" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,2" Margin="0,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="None">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Background" Value="{StaticResource MissingTint}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Small">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Background" Value="{StaticResource WarnTint}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Full">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Background" Value="{StaticResource HaveTint}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Style="{StaticResource BagStatusText}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="130"/>
                            <DataGridTextColumn Header="Bag" Binding="{Binding BagText}" Width="2*" ElementStyle="{StaticResource BagStatusText}"/>
                            <DataGridTextColumn Header="Area" Binding="{Binding AreaText}" Width="90"/>
                            <DataGridTextColumn Header="Where" Binding="{Binding Where}" Width="*"/>
                            <DataGridTextColumn Header="Slots" Binding="{Binding Slots}" Width="60"/>
                            <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="60"/>
                            <DataGridTextColumn Header="Free" Binding="{Binding Free}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ CHARACTERS ============ -->
            <TabItem Header="Characters">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8" BorderThickness="1"
                            BorderBrush="{StaticResource MutedBrush}" CornerRadius="4">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Manual class / level for " VerticalAlignment="Center"/>
                            <TextBlock x:Name="OverrideName" FontWeight="SemiBold" VerticalAlignment="Center" Text="(select a character)"/>
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="OverrideClass" Width="160" Margin="0,0,8,0"/>
                            <TextBlock Text="Level" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="OverrideLevel" Width="90" Margin="0,0,8,0" ToolTip="Level 1–60 (blank = not set)"/>
                            <Button Content="Save" Click="OverrideSave_Click" Margin="0,0,8,0"/>
                            <Button Content="Clear" Click="OverrideClear_Click"/>
                            <TextBlock Text="  Used only where the log doesn't say (log /who and level-ups win). Hover Class or Lvl to see where it came from."
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </WrapPanel>
                    </Border>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Hide" Click="HideCharacters_Click" Margin="0,0,8,0"
                                ToolTip="Hide the selected characters from every tab. Their files are not touched."/>
                        <Button x:Name="UnhideButton" Content="Unhide" Click="UnhideCharacters_Click" Margin="0,0,8,0"/>
                        <Button Content="Delete files…" Click="DeleteCharacterFiles_Click" Margin="0,0,16,0"
                                ToolTip="Send the selected characters' inventory, spellbook, log and .ini files to the Recycle Bin."/>
                        <CheckBox x:Name="ShowHiddenCheck" Content="Show hidden" VerticalAlignment="Center" Margin="0,0,16,0"
                                  Click="ShowHidden_Click"/>
                        <TextBlock x:Name="CharactersHint" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                   Text="Ctrl/Shift-click to select several. Sort by Last active to find stale characters."/>
                    </WrapPanel>
                    <DataGrid x:Name="CharactersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended"
                              SelectionChanged="CharactersGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding NameText}" SortMemberPath="Name" Width="130"/>
                            <DataGridTextColumn Header="Last active" Binding="{Binding LastActivityText}" SortMemberPath="LastActivity" Width="100"/>
                            <!-- Where class/level came from is in the tooltip to save width. -->
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassText}" Width="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                        <Setter Property="ToolTip" Value="{Binding ClassSource, StringFormat='Class from: {0}'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Lvl" Binding="{Binding LevelText}" SortMemberPath="Level" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                        <Setter Property="ToolTip" Value="{Binding LevelSource, StringFormat='Level from: {0}'}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Guild" Binding="{Binding GuildText}" Width="*" MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                        <Setter Property="ToolTip" Value="{Binding GuildTip}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="Bound" Binding="{Binding BindText}" Width="*" MinWidth="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                        <Setter Property="ToolTip" Value="{Binding BindTip}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Last log" Binding="{Binding LastSeenText}" Width="90"/>
                            <DataGridTextColumn Header="Bags free" Binding="{Binding BagsText}" Width="90"/>
                            <DataGridTextColumn Header="Bank free" Binding="{Binding BankText}" Width="90"/>
                            <DataGridTextColumn Header="Inventory" Binding="{Binding InventoryAge}" Width="90"/>
                            <DataGridTextColumn Header="Spellbook" Binding="{Binding SpellbookAge}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ FRIENDS ============ -->
            <TabItem Header="Friends">
                <DockPanel Margin="0,8,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Sync friends lists…" Click="SyncFriends_Click" Margin="0,0,12,0"
                                ToolTip="Give your characters the same friends list (edits each Name_server.ini, with a backup)."/>
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                   Text="Combine everyone's friends and copy the list to each character."/>
                    </WrapPanel>
                    <TextBlock x:Name="FriendsSummary" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"/>
                    <DataGrid x:Name="FriendsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Friend" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="Lvl" Binding="{Binding Level}" Width="50"/>
                            <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="120"/>
                            <DataGridTextColumn Header="Race" Binding="{Binding Race}" Width="100"/>
                            <DataGridTextColumn Header="Guild" Binding="{Binding Guild}" Width="150"/>
                            <DataGridTextColumn Header="Last seen online" Binding="{Binding LastOnlineText}" Width="130"/>
                            <DataGridTextColumn Header="Where" Binding="{Binding Zone}" Width="120"/>
                            <DataGridTextColumn Header="Friend of" Binding="{Binding FriendOf}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ SPELLS ============ -->
            <TabItem Header="Spells">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="SpellCharacters" SelectionChanged="SpellCharacters_SelectionChanged" Margin="0,0,8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock x:Name="SpellHeader" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SpellSubHeader" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            <WrapPanel Margin="0,6,0,0">
                                <RadioButton x:Name="ShowAllSpells" GroupName="SpellView" Content="Show all spells" IsChecked="True"
                                             Margin="0,0,16,0" Click="SpellFilter_Click"/>
                                <RadioButton x:Name="ShowMissingSpells" GroupName="SpellView" Content="Show missing spells"
                                             Margin="0,0,24,0" Click="SpellFilter_Click"/>
                                <CheckBox x:Name="ShowFuture" Content="Show spells above my level" IsChecked="False" Margin="0,0,16,0" Click="SpellFilter_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <DataGrid x:Name="SpellsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="None" MouseDoubleClick="Spells_DoubleClick">
                            <DataGrid.Resources>
                                <!-- Color the cell text only; restyling DataGridRow drops the Fluent row look (white rows in dark mode). -->
                                <Style x:Key="SpellText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Missing">
                                            <Setter Property="Foreground" Value="{StaticResource MissingBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Future">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Not in list">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lvl" Binding="{Binding Level}" Width="50" ElementStyle="{StaticResource SpellText}"/>
                                <DataGridTextColumn Header="Spell" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource SpellText}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" ElementStyle="{StaticResource SpellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
