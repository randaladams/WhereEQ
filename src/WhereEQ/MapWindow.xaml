<Window x:Class="WhereEQ.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhereEQ"
        Title="WhereEQ Map" Width="420" Height="420" MinWidth="160" MinHeight="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid>
        <!-- See-through backdrop; its opacity is the "Backdrop" slider. Corner radius for a softer overlay. -->
        <Border x:Name="Backdrop" Background="Black" Opacity="0.35" CornerRadius="6"/>
        <Border x:Name="Frame" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="6"/>

        <local:MapView x:Name="View" Margin="2"/>

        <!-- Zone name always shown (small) so you know which map it is, even when locked. -->
        <TextBlock x:Name="ZoneCaption" Margin="8,6,8,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                   Foreground="White" FontSize="12" FontWeight="SemiBold" IsHitTestVisible="False">
            <TextBlock.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/></TextBlock.Effect>
        </TextBlock>

        <!-- Title bar: drag to move. Hidden while locked (click-through). -->
        <Border x:Name="TitleBar" VerticalAlignment="Top" Background="#CC1E1E1E" CornerRadius="6,6,0,0"
                MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll">
            <DockPanel Margin="6,2">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="FollowButton" Content="◎" ToolTip="Follow my character" Padding="6,0" Margin="2,0"
                                  Click="Follow_Click" Cursor="Arrow"/>
                    <Button Content="⤢" ToolTip="Fit the whole zone (or double-click the map)" Padding="6,0" Margin="2,0"
                            Click="Fit_Click" Cursor="Arrow"/>
                    <ToggleButton x:Name="OptionsButton" Content="⚙" ToolTip="Options" Padding="6,0" Margin="2,0"
                                  Click="Options_Click" Cursor="Arrow"/>
                    <Button Content="🔒" ToolTip="Lock: clicks go through to the game (Ctrl+Alt+M toggles)" Padding="6,0" Margin="2,0"
                            Click="Lock_Click" Cursor="Arrow"/>
                    <Button Content="✕" ToolTip="Close map" Padding="6,0" Margin="2,0" Click="Close_Click" Cursor="Arrow"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="12" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Options panel (⚙). -->
        <Border x:Name="OptionsPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="6,38,6,0"
                Background="#EE202020" CornerRadius="6" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Character" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <ComboBox x:Name="CharacterBox" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="CharacterBox_Changed"/>
                <TextBlock Grid.Row="1" Text="Map" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <ComboBox x:Name="MapBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="MapBox_Changed"/>
                <TextBlock Grid.Row="2" Text="Lines" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <ComboBox x:Name="StyleBox" Width="110" SelectionChanged="StyleBox_Changed"/>
                    <CheckBox x:Name="LabelsCheck" Content="Labels" Foreground="White" Margin="12,0,0,0" Click="Labels_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Backdrop" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <Slider x:Name="BackdropSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="0.9" Margin="0,0,0,6"
                        ValueChanged="Backdrop_Changed"/>
                <TextBlock Grid.Row="4" Text="Map opacity" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <Slider x:Name="OpacitySlider" Grid.Row="4" Grid.Column="1" Minimum="0.2" Maximum="1" Margin="0,0,0,6"
                        ValueChanged="Opacity_Changed"/>
                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="11" Foreground="#BBBBBB"
                           Text="Wheel: zoom · Drag: pan · Double-click: fit · 🔒 or Ctrl+Alt+M: click-through. EverQuest must run in windowed mode for the map to show on top."/>
            </Grid>
        </Border>

        <!-- Status line: character, loc age, coordinates. -->
        <TextBlock x:Name="StatusText" Margin="8,0,24,6" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Foreground="#DDFFFFFF" FontSize="11" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
            <TextBlock.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/></TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
