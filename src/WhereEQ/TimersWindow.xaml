<Window x:Class="WhereEQ.TimersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhereEQ Timers" Width="240" Height="200" MinWidth="150" MinHeight="70"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/>

        <!-- Countdown text: yellow in the last minute, green when up. -->
        <Style x:Key="LeftStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Soon">
                    <Setter Property="Foreground" Value="#FFD54F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Up">
                    <Setter Property="Foreground" Value="#69F0AE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unknown">
                    <Setter Property="Foreground" Value="#BBBBBB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="DimCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CellStyle}">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <!-- Compact: countdown + mob. -->
        <DataTemplate x:Key="CompactTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LeftText}" Style="{StaticResource LeftStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding Mob}" Style="{StaticResource CellStyle}"/>
            </Grid>
        </DataTemplate>

        <!-- Details: + zone, kill time, killer, timer length. -->
        <DataTemplate x:Key="DetailsTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Zone"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Killed"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="By"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Timer"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LeftText}" Style="{StaticResource LeftStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding Mob}" Style="{StaticResource CellStyle}"/>
                <TextBlock Grid.Column="2" Text="{Binding ZoneText}" Style="{StaticResource DimCellStyle}" MaxWidth="150"/>
                <TextBlock Grid.Column="3" Text="{Binding KilledText}" Style="{StaticResource DimCellStyle}"/>
                <TextBlock Grid.Column="4" Text="{Binding By}" Style="{StaticResource DimCellStyle}" MaxWidth="110"/>
                <TextBlock Grid.Column="5" Text="{Binding RespawnText}" Style="{StaticResource DimCellStyle}"
                           ToolTip="{Binding RespawnSourceText}"/>
            </Grid>
        </DataTemplate>

        <!-- Plain rows (the Fluent ListBoxItem is tall and opaque): thin highlight when selected. -->
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Backdrop" Background="Black" Opacity="0.35" CornerRadius="6"/>
        <Border x:Name="Frame" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="6"/>

        <DockPanel>
            <!-- Title bar: drag to move. Hidden while locked (click-through). -->
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="#CC1E1E1E" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown" Cursor="SizeAll">
                <DockPanel Margin="6,2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="DetailsButton" Content="☰" ToolTip="Show zone, kill time, killer and timer (wider)"
                                      Padding="6,0" Margin="2,0" Click="Details_Click" Cursor="Arrow"/>
                        <ToggleButton x:Name="OptionsButton" Content="⚙" ToolTip="Options, start a timer by hand"
                                      Padding="6,0" Margin="2,0" Click="OptionsButton_Click" Cursor="Arrow"/>
                        <Button Content="🔒" ToolTip="Lock: clicks go through to the game (Ctrl+Alt+T toggles)" Padding="6,0" Margin="2,0"
                                Click="Lock_Click" Cursor="Arrow"/>
                        <Button Content="✕" ToolTip="Close timers" Padding="6,0" Margin="2,0" Click="Close_Click" Cursor="Arrow"/>
                    </StackPanel>
                    <TextBlock Text="Timers" Foreground="White" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                </DockPanel>
            </Border>

            <Grid Margin="2,4,2,14">
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" FontSize="12"
                         Grid.IsSharedSizeScope="True" ItemContainerStyle="{StaticResource RowStyle}"
                         ItemTemplate="{StaticResource CompactTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="List_SelectionChanged" PreviewKeyDown="List_KeyDown">
                    <ListBox.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/>
                    </ListBox.Effect>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Restart timer now" Click="Restart_Click"/>
                            <MenuItem Header="Remove" Click="Remove_Click" InputGestureText="Del"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock x:Name="EmptyText" Margin="8,2" Foreground="#DDFFFFFF" FontSize="11" TextWrapping="Wrap"
                           IsHitTestVisible="False" Effect="{StaticResource Shadow}"
                           Text="No timers. One starts when you kill a mob."/>
            </Grid>
        </DockPanel>

        <!-- Options panel (⚙). -->
        <Border x:Name="OptionsPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="4,30,4,4"
                Background="#EE202020" CornerRadius="6" Padding="10">
            <StackPanel>
                <CheckBox x:Name="OthersCheck" Content="Kills by others and pets" Foreground="White" Margin="0,0,0,6"
                          Click="Others_Click"
                          ToolTip="Also time mobs killed by other players and pets (&quot;a rat has been slain by Somebody!&quot;)."/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Keep up timers" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="KeepBox" SelectionChanged="Keep_Changed"
                              ToolTip="How long a timer stays in the list after the mob is up again."/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Backdrop" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="BackdropSlider" Minimum="0" Maximum="0.9" ValueChanged="Backdrop_Changed"/>
                </DockPanel>
                <TextBlock Text="Start a timer by hand, or save a mob's respawn time:" Foreground="#BBBBBB" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MobBox" ToolTip="Mob name (click a timer to fill this in)"/>
                    <TextBox x:Name="TimeBox" Grid.Column="1" Margin="6,0,0,0" ToolTip="Respawn time: minutes (22), m:ss (6:40) or h:mm:ss"/>
                </Grid>
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="Start timer" Padding="8,2" Margin="0,0,6,4" Click="Start_Click"
                            ToolTip="Start a countdown for this mob now (e.g. one killed out of sight)."/>
                    <Button Content="Save time" Padding="8,2" Margin="0,0,6,4" Click="SaveTime_Click"
                            ToolTip="Always use this respawn time for this mob in this zone."/>
                    <Button Content="Clear all" Padding="8,2" Margin="0,0,6,4" Click="Clear_Click" ToolTip="Remove every timer."/>
                </WrapPanel>
                <TextBlock x:Name="HintText" Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
