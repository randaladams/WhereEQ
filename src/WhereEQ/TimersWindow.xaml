<Window x:Class="WhereEQ.TimersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhereEQ Timers" Width="640" Height="420" MinWidth="360" MinHeight="200"
        ShowInTaskbar="True">
    <DockPanel Margin="10">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <CheckBox x:Name="OthersCheck" Content="Kills by others" Margin="0,0,16,0" Click="Options_Click"
                      ToolTip="Also time mobs killed by other players and pets (&quot;a rat has been slain by Somebody!&quot;)."/>
            <CheckBox x:Name="TopmostCheck" Content="Always on top" Margin="0,0,16,0" Click="Options_Click"/>
            <TextBlock Text="Keep for" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="KeepBox" Width="110" Margin="0,0,16,0" SelectionChanged="Keep_Changed"
                      ToolTip="How long a timer stays in the list after the mob is up again."/>
            <Button Content="Clear all" Padding="10,2" Click="Clear_Click" ToolTip="Remove every timer in the list."/>
        </WrapPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="MobBox" ToolTip="Mob name (pick a timer above to fill this in)"/>
            <TextBox x:Name="TimeBox" Grid.Column="1" Margin="6,0,0,0" ToolTip="Respawn time: minutes, m:ss or h:mm:ss"/>
            <Button Grid.Column="2" Content="Start timer" Margin="6,0,0,0" Padding="10,2" Click="Start_Click"
                    ToolTip="Start a countdown for this mob now (e.g. one killed out of sight)."/>
            <Button Grid.Column="3" Content="Save time" Margin="6,0,0,0" Padding="10,2" Click="SaveTime_Click"
                    ToolTip="Always use this respawn time for this mob in this zone (also updates timers in the list)."/>
            <TextBlock x:Name="HintText" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                       Opacity="0.75"/>
        </Grid>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserResizeRows="False"
                  SelectionChanged="Grid_SelectionChanged" PreviewKeyDown="Grid_KeyDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Restart timer now" Click="Restart_Click"/>
                    <MenuItem Header="Remove" Click="Remove_Click" InputGestureText="Del"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Respawns in" Binding="{Binding LeftText}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Soon">
                                    <Setter Property="Foreground" Value="#FFC107"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Up">
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Unknown">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="Opacity" Value="0.7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Mob" Binding="{Binding Mob}" Width="2*"/>
                <DataGridTextColumn Header="Zone" Binding="{Binding ZoneText}" Width="*"/>
                <DataGridTextColumn Header="Killed" Binding="{Binding KilledText}" Width="70"/>
                <DataGridTextColumn Header="By" Binding="{Binding By}" Width="*"/>
                <DataGridTextColumn Header="Timer" Binding="{Binding RespawnText}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                            <Setter Property="ToolTip" Value="{Binding RespawnSourceText}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
