<Window x:Class="WhereEQ.TimersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhereEQ"
        Title="WhereEQ Timers &amp; Buffs" Width="240" Height="360" MinWidth="150" MinHeight="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/>

        <!-- Countdown text: yellow in the last minute, green when up. -->
        <Style x:Key="LeftStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Soon">
                    <Setter Property="Foreground" Value="#FFD54F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Up">
                    <Setter Property="Foreground" Value="#69F0AE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unknown">
                    <Setter Property="Foreground" Value="#BBBBBB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="CountUp">
                    <Setter Property="Foreground" Value="#90CAF9"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="DimCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CellStyle}">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <Style x:Key="SideButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#665A8DEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tiny flat buttons in front of each timer: ✕ removes it, 🔔 beeps 30 s before the respawn. -->
        <Style x:Key="RowButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Foreground" Value="#FFD54F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="RowButtons">
            <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                <Button Content="✕" Style="{StaticResource RowButton}" Click="RowRemove_Click" ToolTip="Remove this timer"/>
                <ToggleButton Content="🔔" IsChecked="{Binding Alert, Mode=TwoWay}"
                              Click="RowAlert_Click" ToolTip="Beep 30 seconds before it respawns">
                    <!-- No alert for count-up timers (no respawn time); keep the space so columns line up. -->
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource RowButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDue}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </StackPanel>
        </DataTemplate>

        <!-- Compact: countdown + mob. -->
        <DataTemplate x:Key="CompactTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentTemplate="{StaticResource RowButtons}"/>
                <TextBlock Grid.Column="1" Text="{Binding LeftText}" Style="{StaticResource LeftStyle}"/>
                <TextBlock Grid.Column="2" Text="{Binding Mob}" Style="{StaticResource CellStyle}"/>
            </Grid>
        </DataTemplate>

        <!-- Details: + zone, kill time, killer, timer length. -->
        <DataTemplate x:Key="DetailsTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Left"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Zone"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Killed"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="By"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Timer"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentTemplate="{StaticResource RowButtons}"/>
                <TextBlock Grid.Column="1" Text="{Binding LeftText}" Style="{StaticResource LeftStyle}"/>
                <TextBlock Grid.Column="2" Text="{Binding Mob}" Style="{StaticResource CellStyle}"/>
                <TextBlock Grid.Column="3" Text="{Binding ZoneText}" Style="{StaticResource DimCellStyle}" MaxWidth="150"/>
                <TextBlock Grid.Column="4" Text="{Binding KilledText}" Style="{StaticResource DimCellStyle}"/>
                <TextBlock Grid.Column="5" Text="{Binding By}" Style="{StaticResource DimCellStyle}" MaxWidth="110"/>
                <TextBlock Grid.Column="6" Text="{Binding RespawnText}" Style="{StaticResource DimCellStyle}"
                           ToolTip="{Binding RespawnSourceText}"/>
            </Grid>
        </DataTemplate>

        <!-- Plain rows (the Fluent ListBoxItem is tall and opaque): thin highlight when selected. -->
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Backdrop" Background="Black" Opacity="0.35" CornerRadius="6"/>
        <Border x:Name="Frame" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="6"/>

        <DockPanel>
            <!-- Buttons run down the right side; drag the strip to move the window. Hidden while locked. -->
            <Border x:Name="TitleBar" DockPanel.Dock="Right" Background="#CC1E1E1E" CornerRadius="0,6,6,0"
                    Cursor="SizeAll" ToolTip="Drag here or anywhere on the list to move">
                <StackPanel Margin="2,4,2,16">
                    <TextBlock Text="⠿" Foreground="#AAFFFFFF" HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,2"/>
                    <ToggleButton x:Name="DetailsButton" Content="☰" ToolTip="Show zone, kill time, killer and timer (wider)"
                                  Style="{StaticResource SideButton}" Click="Details_Click"/>
                    <ToggleButton x:Name="OptionsButton" Content="⚙" ToolTip="Options, start a timer by hand"
                                  Style="{StaticResource SideButton}" Click="OptionsButton_Click"/>
                    <Button Content="🔒" ToolTip="Lock: clicks go through to the game (Ctrl+Alt+T toggles)"
                            Style="{StaticResource SideButton}" Click="Lock_Click"/>
                    <Button Content="✕" ToolTip="Close timers" Style="{StaticResource SideButton}" Click="Close_Click"/>
                </StackPanel>
            </Border>

            <!-- Timers on top, buffs below; drag the bar between them to give either more room. -->
            <Grid x:Name="Split" Margin="2,4,2,4">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TimersRow" Height="*" MinHeight="0"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="BuffsRow" Height="*" MinHeight="0"/>
                </Grid.RowDefinitions>
                <GridSplitter x:Name="Splitter" Grid.Row="1" Height="7" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent"
                              Cursor="SizeNS" DragCompleted="Splitter_DragCompleted"
                              ToolTip="Drag to give timers or buffs more room">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent">
                                <Border x:Name="Line" Height="1" Margin="6,0" Background="#55FFFFFF" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Line" Property="Height" Value="3"/>
                                    <Setter TargetName="Line" Property="Background" Value="#AAFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                <local:BuffsPanel x:Name="Buffs" Grid.Row="2"/>
                <Grid Grid.Row="0">
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" FontSize="12"
                         Grid.IsSharedSizeScope="True" ItemContainerStyle="{StaticResource RowStyle}"
                         ItemTemplate="{StaticResource CompactTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="List_SelectionChanged" PreviewKeyDown="List_KeyDown">
                    <ListBox.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="1"/>
                    </ListBox.Effect>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Restart timer now" Click="Restart_Click"/>
                            <MenuItem Header="Remove" Click="Remove_Click" InputGestureText="Del"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock x:Name="EmptyText" Margin="8,2" Foreground="#DDFFFFFF" FontSize="11" TextWrapping="Wrap"
                           IsHitTestVisible="False" Effect="{StaticResource Shadow}"
                           Text="No timers. One starts when you kill a mob."/>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- Options panel (⚙). -->
        <Border x:Name="OptionsPanel" Visibility="Collapsed" VerticalAlignment="Top" Margin="4,4,34,4"
                Background="#EE202020" CornerRadius="6" Padding="10">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Backdrop" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="BackdropSlider" Minimum="0" Maximum="0.9" ValueChanged="Backdrop_Changed"/>
                </DockPanel>
                <TextBlock Text="Timers" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,4"/>
                <CheckBox x:Name="OthersCheck" Content="Kills by others and pets" Foreground="White" Margin="0,0,0,6"
                          Click="Others_Click"
                          ToolTip="Also time mobs killed by other players and pets (&quot;a rat has been slain by Somebody!&quot;)."/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Keep up timers" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="KeepBox" SelectionChanged="Keep_Changed"
                              ToolTip="How long a timer stays in the list after the mob is up again."/>
                </DockPanel>
                <TextBlock Text="Start a timer by hand, or save a mob's respawn time:" Foreground="#BBBBBB" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MobBox" ToolTip="Mob name (click a timer to fill this in)"/>
                    <TextBox x:Name="TimeBox" Grid.Column="1" Margin="6,0,0,0" ToolTip="Respawn time: minutes (22), m:ss (6:40) or h:mm:ss"/>
                </Grid>
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="Start timer" Padding="8,2" Margin="0,0,6,4" Click="Start_Click"
                            ToolTip="Start a countdown for this mob now (e.g. one killed out of sight)."/>
                    <Button Content="Save time" Padding="8,2" Margin="0,0,6,4" Click="SaveTime_Click"
                            ToolTip="Always use this respawn time for this mob in this zone."/>
                    <Button Content="Clear all" Padding="8,2" Margin="0,0,6,4" Click="Clear_Click" ToolTip="Remove every timer."/>
                </WrapPanel>
                <TextBlock x:Name="HintText" Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Buffs" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Character" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="BuffsCharacterBox" SelectionChanged="BuffsCharacter_Changed"
                              ToolTip="Whose buffs to show. Active = whoever's log changed most recently."/>
                </DockPanel>
                <CheckBox x:Name="BuffsOthersCheck" Content="Spells you cast on others" Foreground="White" Margin="0,0,0,8"
                          Click="BuffsOthers_Click"
                          ToolTip="Mez, DoTs, slows and buffs you cast on mobs and groupmates, until they wear off."/>
                <TextBlock x:Name="BuffsHintText" Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
