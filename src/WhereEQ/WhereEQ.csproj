<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WPF Fluent ThemeMode is still flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyTitle>WhereEQ</AssemblyTitle>
    <Product>WhereEQ</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference spell lists per class: Data/Spells/<Class>.txt ("level<TAB>spell name") -->
    <None Include="Data\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Built-in map files (from EqTool, MIT) and their license notice -->
    <None Include="Data\Maps\NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
